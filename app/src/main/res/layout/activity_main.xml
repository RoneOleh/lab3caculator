<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tg_background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_display"
        android:minHeight="140dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/modeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp"
            android:text="@string/angle_degrees"
            android:textColor="@color/tg_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/expressionTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:hint="@string/zero"
                android:maxLines="1"
                android:textColor="@color/tg_text"
                android:textColorHint="@color/tg_secondary"
                app:autoSizeMaxTextSize="44sp"
                app:autoSizeMinTextSize="20sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform" />

            <Button
                style="@style/CalcBackspace"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/key_backspace"
                android:onClick="onButtonClick"
                android:text="⌫" />

        </LinearLayout>

        <TextView
            android:id="@+id/resultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="end"
            android:maxLines="1"
            android:minHeight="34dp"
            android:textColor="@color/tg_secondary"
            android:textSize="24sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingEnd="13dp">

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="√" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="π" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="e" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="^" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="!" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:contentDescription="@string/key_more"
            android:onClick="onButtonClick"
            android:text="▾" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/extraRow"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingEnd="13dp">

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="sin" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="cos" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="tan" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="ln" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="log" />

        <com.example.lab3.SquareButton
            style="@style/CalcSci"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="Deg" />

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.example.lab3.SquareButton
            style="@style/CalcOperator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="÷" />

        <com.example.lab3.SquareButton
            style="@style/CalcOperator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="×" />

        <com.example.lab3.SquareButton
            style="@style/CalcOperator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="−" />

        <com.example.lab3.SquareButton
            style="@style/CalcOperator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="+" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="7" />

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="8" />

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="9" />

        <com.example.lab3.SquareButton
            style="@style/CalcClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="AC" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="4" />

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="5" />

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="6" />

        <com.example.lab3.SquareButton
            style="@style/CalcClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="( )" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="1" />

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="2" />

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="3" />

        <com.example.lab3.SquareButton
            style="@style/CalcClear"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="%" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="0" />

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="00" />

        <com.example.lab3.SquareButton
            style="@style/CalcDigit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="." />

        <com.example.lab3.SquareButton
            style="@style/CalcEqual"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:onClick="onButtonClick"
            android:text="=" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:onClick="onHistoryClick"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_history" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/history"
                android:textColor="@color/tg_text"
                android:textSize="17sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_margin="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_bar"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:onClick="onHandwritingClick"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pen" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/handwriting"
                android:textColor="@color/tg_text"
                android:textSize="17sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
